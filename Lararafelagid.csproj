<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Lararafelagid</AssemblyName>
    <RootNamespace>Lararafelagid</RootNamespace>

    <!-- Important for Simply -->
    <CopyRefAssembliesToPublishDirectory>true</CopyRefAssembliesToPublishDirectory>
    <RuntimeIdentifiers>win-x86</RuntimeIdentifiers>


    <!-- Razor behavior -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>



  <ItemGroup>
    <PackageReference Include="CMSImport" Version="13.1.5" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.2" />
    <PackageReference Include="Our.Umbraco.Slimsy" Version="5.1.2" />
    <PackageReference Include="Umbraco.Cms" Version="13.9.3" />
  </ItemGroup>
  

  <ItemGroup>
    <Content Update="appsettings*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="app_offline.htm" />
    <Content Remove="app_offline.htm" />
  </ItemGroup>

  <Target Name="StripAppOffline" AfterTargets="Publish">
    <Delete Files="$(PublishDir)app_offline.htm" />
  </Target>

  <ItemGroup>
    <Content Update="Views\**\*.cshtml" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Partials\**\*" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="MacroPartials\**\*" CopyToPublishDirectory="PreserveNewest" />

  </ItemGroup>
</Project>
