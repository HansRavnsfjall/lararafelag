2023</span><header><h1 class="text-center font-bold mb-2 text-[28px] leading-9" itemprop="headline" lang="en">The Northern Hemisphere Winter Will Officially Begin On December 21st</h1></header></article><p class="text-center uppercase font-bold text-[15px] leading-[18px] mb-[10px]">By Kavi  Dolasia<span>
- 378 words</span></p><div class="post-controls-container flex justify-evenly flex-wrap my-[20px]"><div class="languages-container"><h4 class="text-[13px] font-bold uppercase text-center mb-[15px]">Language</h4><astro-island uid="Z2aCO5n" component-url="https://cdn.dogonews.com/p/_astro/LanguageSwitch.b9a1c938.js" component-export="default" renderer-url="https://cdn.dogonews.com/p/_astro/client.bb1cf6b8.js" props="{&quot;switchId&quot;:[0,&quot;language-switch&quot;],&quot;offText&quot;:[0,&quot;English&quot;],&quot;onText&quot;:[0,&quot;Spanish&quot;],&quot;initialChecked&quot;:[0,false],&quot;height&quot;:[0,32],&quot;width&quot;:[0,160],&quot;handleWidth&quot;:[0,80]}" ssr="" client="only" opts="{&quot;name&quot;:&quot;LanguageSwitch&quot;,&quot;value&quot;:&quot;react&quot;}"></astro-island></div><div class="reading-levels-container"><h4 class="text-[13px] font-bold uppercase text-center mb-[15px]">Reading Level</h4><astro-island uid="2x0be8" component-url="https://cdn.dogonews.com/p/_astro/ReadingLevelSwitch.5251aff3.js" component-export="default" renderer-url="https://cdn.dogonews.com/p/_astro/client.bb1cf6b8.js" props="{&quot;switchId&quot;:[0,&quot;reading-level-switch&quot;],&quot;offText&quot;:[0,&quot;Original&quot;],&quot;onText&quot;:[0,&quot;Simplified&quot;],&quot;initialChecked&quot;:[0,false],&quot;height&quot;:[0,32],&quot;width&quot;:[0,160],&quot;handleWidth&quot;:[0,80]}" ssr="" client="only" opts="{&quot;name&quot;:&quot;ReadingLevelSwitch&quot;,&quot;value&quot;:&quot;react&quot;}"></astro-island></div><div class="listen-container"><h4 class="text-[13px] font-bold uppercase text-center mb-[15px]">Listen</h4><astro-island uid="Z1h2mjF" component-url="https://cdn.dogonews.com/p/_astro/PlayPauseButton.412fd37b.js" component-export="default" renderer-url="https://cdn.dogonews.com/p/_astro/client.ef651e53.js" props="{&quot;buttonText&quot;:[0,&quot;3 minutes&quot;]}" ssr="" client="idle" opts="{&quot;name&quot;:&quot;PlayPauseButton&quot;,&quot;val