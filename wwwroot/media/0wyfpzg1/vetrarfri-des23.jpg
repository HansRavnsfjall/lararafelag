  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }
  gtag("js", new Date());
  gtag("config", id, {
    anonymize_ip: true,
    cookie_flags: "SameSite=None;Secure",
  });

  function onGaTrackingClick(event) {
    const el = event.target.closest('.ga-tracking');
    if (!el) return;

    const trackingUrl = el.dataset.trackingUrl;
    let pathToTrack = trackingUrl;

    if (!pathToTrack || !pathToTrack.length) {
      const canonicalElement = document.querySelector('link[rel="canonical"]');
      const trackingPath = el.dataset.trackingPath;

      if (canonicalElement && trackingPath && trackingPath.length) {
        const baseUrl = canonicalElement.getAttribute('href');
        pathToTrack = baseUrl.endsWith('/') ? `${baseUrl}${trackingPath}` : `${baseUrl}/${trackingPath}`;
      }
    }

    if (pathToTrack && pathToTrack.length) {
      gtag('event', 'page_view', {page_path: pathToTrack});
      console.log('GA Page View', pathToTrack);
    }
  }

  if (!window.gaInitialized) {
    document.addEventListener('click', onGaTrackingClick, true);
    console.log('GA Initialized');
    window.gaInitialized = true;
  }
})();</script><link rel="alternate" type="application/rss+xml" title="RSS" href="/2023/12/12/the-northern-hemisphere-winter-will-officially-begin-on-december-21st.rss"><meta name="astro-view-transitions-enabled" content="true"><meta name="astro-view-transitions-fallback" content="animate"><link rel="stylesheet" href="https://cdn.dogonews.com/p/_astro/3.57db3024.css" />
