@using Umbraco.Cms.Core.Models.PublishedContent
@using Lararafelagid 
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IPublishedContent>


@{
    var siteSettings = Model.GetSiteSettings();
    var hasSettings = siteSettings != null;

    // preload values only if settings exist
    var siteName = hasSettings ? siteSettings.Value<string>("siteName") : "";
    var footerCol2Heading = hasSettings ? siteSettings.Value<string>("footerCol2Heading") : "";
    var footerCol2Text = hasSettings ? siteSettings.Value<string>("footerCol2Text") : "";

    // Media properties
    var logoMedia = hasSettings ? siteSettings.Value<IPublishedContent>("logo") : null;
    var logoUrl = logoMedia?.Url() ?? "";

    var footerLogoMedia = hasSettings ? siteSettings.Value<IPublishedContent>("footerLogo") : null;
    var footerLogoUrl = footerLogoMedia?.Url() ?? "";
}

@{
    var isSiteSkulablad = Model?.Root()?.Key == Guid.Parse("81f22605-925d-4848-bb38-b886783b2083");
}



<!DOCTYPE html>
<html data-site-root="@Model?.Root()?.Key" lang="fo">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@siteName</title>
    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link href="~/css/custom.css" rel="stylesheet" asp-append-version="true" />

@if (isSiteSkulablad)
{
    <link href="~/css/skulablad.css" rel="stylesheet" asp-append-version="true" />
}

    <link
      href="https://fonts.googleapis.com/css2?family=Geologica:wght@300;400;500;700&family=Roboto+Serif:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- _Layout.cshtml -->
    @if (isSiteSkulablad)
{
<script type="module" src="/scripts/sb-search.js" defer></script>
}
else{
<script type="module" src="/scripts/lf-search.js" defer></script>
}
  </head>
  <body>

    @if (hasSettings)
    {
        @await Html.PartialAsync("header")
    }

    @RenderBody()

    @if (hasSettings)
    {
        @await Html.PartialAsync("footer")
    }


<!-- TYPEAHEAD OVERLAY -->
<div id="search-overlay" class="lfso" data-results-url="/leiting" aria-hidden="true">
  <div class="lfso__backdrop" data-close></div>

  <div class="lfso__shell" role="dialog" aria-modal="true" aria-labelledby="lfso-title">
    <button class="lfso__close" aria-label="Lat aftur" data-close>&times;</button>

    <form class="lfso__form" onsubmit="return false;">
      <label for="so-input" id="lfso-title" class="visually-hidden">Leit</label>
      <div class="lfso__inputwrap">
        <input id="so-input" class="lfso__input" type="search" placeholder="Skriva at leita…" autocomplete="off" />
        <button type="button" id="so-submit" class="lfso__submit" aria-label="Leita">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M21 21l-5.2-5.2m1.4-4.2a6 6 0 11-12 0 6 6 0 0112 0z"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </form>

    <div id="so-results" class="lfso__results" aria-live="polite" aria-busy="false"></div>
  </div>
</div>

<!-- Example trigger somewhere in header -->
<!-- <a href="#" data-action="open-search">Leita</a> -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!--<script src="/js/lf-typeahead.js"></script>-->

<script>
const lfso = document.querySelector('.lfso');
const lfsoInput = document.querySelector('.lfso__input');

// Listen for transition end (fade-in complete)
lfso.addEventListener('transitionend', (e) => {
  if (e.propertyName === 'opacity' && lfso.classList.contains('open')) {
    lfsoInput?.focus();
  }
});
</script>

<script defer data-domain="lararafelag.fo.nt14.unoeuro-server.com" src="https://plausible.io/js/script.file-downloads.hash.outbound-links.pageview-props.revenue.tagged-events.js"></script>
<script>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
</body>
</html>
