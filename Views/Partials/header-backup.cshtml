@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Web
@using Umbraco.Extensions
@using System
@using System.Linq
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IPublishedContent>

@{
    var siteRoot = Model?.Root();
    var isSiteSkulablad = siteRoot?.Key == Guid.Parse("81f22605-925d-4848-bb38-b886783b2083");

    // Level 1 (visible children of root)
    var level1Nodes = siteRoot?
        .Children?
        .Where(c => c.Value<bool?>("hideInMenu") != true)
        .ToList() ?? new List<IPublishedContent>();
}

<section class="header">
