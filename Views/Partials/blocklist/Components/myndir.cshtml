@using System
@using System.Linq
@using System.Collections.Generic
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem<ContentModels.Myndir>>

@{
    // Images from the block field "valdarMyndir"
    var images = Model.Content.Value<IEnumerable<MediaWithCrops>>("valdarMyndir") ?? Enumerable.Empty<MediaWithCrops>();

    // Unique Fancybox group per block so multiple instances on the same page don't collide
    var groupId = "gallery-" + Model.Content.Key.ToString("N");
    var yvirskrift = Model.Content.Yvirskrift;

    // Keys to guard one-time asset emission
    const string FancyStyleKey = "__fancybox_style_emitted";
    const string FancyScriptKey = "__fancybox_script_emitted";
}

@if (images.Any())
{
    // Emit Fancybox CSS once per request
    if (!Context.Items.ContainsKey(FancyStyleKey))
    {
        Context.Items[FancyStyleKey] = true;
        <link rel="stylesheet" href="@("https://cdn.jsdelivr.net/npm/@fancyapps/ui/dist/fancybox.css")" />
    }
<div class="container myndirareahead">
<div class="row">
<div class="col-12">
  <h3>@yvirskrift</h3>
  </div>
</div>
</div>
    <section class="gallery-section my-4" data-gallery-id="@groupId">
        <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-4 g-3">
      
            @foreach (var media in images)
            {
                if (media == null) { continue; }

                var fullUrl = media.Url();
                if (string.IsNullOrWhiteSpace(fullUrl)) { continue; }

                string thumbUrl = null;
                try { thumbUrl = media.GetCropUrl("squareGallery"); } catch { thumbUrl = null; }
                if (string.IsNullOrWhiteSpace(thumbUrl))
                {
                    thumbUrl = media.GetCropUrl(width: 600, height: 600, imageCropMode: ImageCropMode.Crop) ?? fullUrl;
                }

                var alt = media.Value<string>("altText");
                if (string.IsNullOrWhiteSpace(alt)) alt = media.Name;

                <div class="col">
                    <a href="@fullUrl"
                       data-fancybox="@groupId"
                       data-caption="@alt"
                       class="d-block text-decoration-none">
                        <div class="ratio ratio-1x1 bg-light overflow-hidden">
                            <img src="@thumbUrl"
                                 alt="@alt"
                                 class="w-100 h-100"
                                 style="object-fit:cover;"
                                 loading="lazy" />
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>

    // Emit Fancybox JS once per request and bind to all groups that start with "gallery-"
    if (!Context.Items.ContainsKey(FancyScriptKey))
    {
        Context.Items[FancyScriptKey] = true;
        <script src="@("https://cdn.jsdelivr.net/npm/@fancyapps/ui/dist/fancybox.umd.js")"></script>
        <script>
        document.addEventListener("DOMContentLoaded", function () {
          Fancybox.bind("[data-fancybox^='gallery-']", {
            Thumbs: { type: "classic" },
            Toolbar: { display: ["zoom", "slideshow", "thumbs", "close"] },
            Images: { Panzoom: { maxScale: 3 } }
          });
        });
        </script>
    }
}
