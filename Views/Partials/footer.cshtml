@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Web
@using Umbraco.Extensions

@using Lararafelagid  
@using System
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IPublishedContent>

@{
    var isSiteSkulablad = Model?.Root()?.Key == Guid.Parse("81f22605-925d-4848-bb38-b886783b2083");
}

@{
    var siteSettings = Model.GetSiteSettings();
    if (siteSettings == null) return;
    

    // Simple string properties
    var siteName = siteSettings.Value<string>("siteName");
    var footerCol2Heading = siteSettings.Value<string>("footerCol2Heading");
    var footerCol2Text = siteSettings.Value<string>("footerCol2Text");
     var footerCol3Heading = siteSettings.Value<string>("footerCol3Heading");
    var footerCol3Text = siteSettings.Value<string>("footerCol3Text");

    // Media properties
    var logoMedia = siteSettings.Value<IPublishedContent>("logo");
    var logoUrl = logoMedia?.Url() ?? "";

    var footerLogoMedia = siteSettings.Value<IPublishedContent>("footerLogo");
    var footerLogoUrl = footerLogoMedia?.Url() ?? "";
}



<section class="footer">
    <div class="container-fluid footer">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="footer-content-wrapper">
                       @if (isSiteSkulablad)
                       
                        
{ <div class="col-12 col-md-2">
  <div class="skulablad-logo"><span>SKÚLA</span><span class="bladid">BLAÐIÐ</span></div>
  </div>
}else{ <div class="col-md-1 col-12">
                            <img src="@logoUrl" alt="" />
                            </div>
                            }
                        
                        <div class="col-md-2 col-12">
                          
                            <h4>@footerCol2Heading</h4>
                          
                            @Html.Raw(footerCol2Text)
                        </div>
                        <div class="col-md-3 col-12">
                            <h4>@footerCol3Heading</h4>
                           @Html.Raw(footerCol3Text)
                        </div>
                        
                    </div>
                    
                </div>
